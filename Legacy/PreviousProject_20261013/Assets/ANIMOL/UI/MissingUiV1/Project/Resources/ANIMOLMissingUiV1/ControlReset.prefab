  m_Name: 
  m_EditorClassIdentifier: ANIMOL.MissingUiV1.Project::ANIMOL.MissingUiV1.Project.MissingUtilityText
  Korean: "\uCD08\uAE30\uD654 \uB300\uC0C1\n\uBC84\uD2BC \uD06C\uAE30 \xB7 \uAC00\uB85C
    \uC704\uCE58 \xB7 \uD22C\uBA85\uB3C4\n\uC88C\uC6B0\uC190 \uBC30\uCE58 \xB7 \uC804\uC6A9
    \uD558\uD5A5 \uBC84\uD2BC\n\uD070 \uAE00\uC528 \xB7 \uC9C4\uB3D9 \xB7 \uC5B8\uC5B4
    \uC120\uD0DD\n\n\uAE30\uC874 \uC870\uC791 \uC124\uC815\uC758 \uAE30\uBCF8\uAC12\uC73C\uB85C
    \uBCF5\uC6D0\uD569\uB2C8\uB2E4.\n\n\uACC4\uC815 \uC9C4\uD589\uB3C4, \uB3D9\uBB3C
    \uC131\uC7A5, \uC7AC\uD654, \uAD6C\uB9E4 \uB0B4\uC5ED, \uB85C\uCEEC\xB7\uD074\uB77C\uC6B0\uB4DC
    \uAC8C\uC784 \uC800\uC7A5\uC740 \uBCC0\uACBD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\nBGM/SFX/\uC74C\uC18C\uAC70\uB294
    \uBBF8\uC5F0\uACB0\uC774\uBA70 \uC774\uBC88 \uCD08\uAE30\uD654 \uB300\uC0C1\uC774
    \uC544\uB2D9\uB2C8\uB2E4."
  English: 'Settings to reset

    Control size, horizontal position and opacity

    Handedness
    and dedicated drop button

    Large text, vibration and language preference


    Restores
    the existing control preference defaults.


    Account progress, animal growth,
    currencies, purchases and local/cloud game saves are not changed.


    Music,
    sound and mute are unavailable and are outside this reset.'
  BaseSize: 32
  TextColor: {r: 0.101960786, g: 0.10980392, b: 0.17254902, a: 1}
