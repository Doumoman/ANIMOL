[Unit]
Description=ANIMOL NET02 development lobby HTTP service
After=network.target

[Service]
Type=simple
User=animol
Group=animol
WorkingDirectory=/opt/animol-net02
EnvironmentFile=/etc/animol-net02/service.env
ExecStart=/bin/bash /opt/animol-net02/Tools/Cloud/run-server.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/animol-net02
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
