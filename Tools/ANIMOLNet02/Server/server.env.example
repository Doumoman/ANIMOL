# DEV localhost only by default. LAN test explicitly uses 0.0.0.0 + private IP.
# These are environment variables; do not put account keys/tokens here or commit live databases.
ANIMOL_DEV_BIND=127.0.0.1
ANIMOL_DEV_PORT=8080
# Optional absolute paths. Default config is intentionally empty and denies admission.
# ANIMOL_DEV_CONFIG=/absolute/path/verified-dev-config.json
# ANIMOL_DEV_DATABASE=/absolute/path/private-dev-lobby.sqlite3
